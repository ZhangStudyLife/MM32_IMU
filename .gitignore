# ============================================
# MDK/Keil uVision 编译输出和临时文件
# ============================================

# 编译输出目录
Listings/
Objects/
DebugConfig/
RTE/

# 目标文件和中间文件
*.o
*.d
*.crf
*.axf
*.elf
*.htm
*.lnp
*.sct

# 输出文件
*.hex
*.bin
*.map
*.lst

# 用户选项文件（IDE个人配置）
*.uvoptx
*.uvguix
*.uvguix.*

# 调试器配置文件
JLinkSettings.ini
*.jlink

# ============================================
# IAR EWARM 编译输出和临时文件
# ============================================

# IAR编译输出
Debug/
Release/
settings/

# IAR目标文件
*.pbi
*.pbd
*.pbi.*
*.pbd.*
*.xcl
*.sim
*.dni
*.wsdt
*.dep
*.dbgdt

# IAR用户设置
*.eww
*.ewt
*.ewd

# ============================================
# VS Code 配置
# ============================================

# 保留launch.json和tasks.json，忽略其他
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# ============================================
# Windows 系统文件
# ============================================

# Windows缩略图缓存
Thumbs.db
ehthumbs.db
Desktop.ini

# Windows回收站
$RECYCLE.BIN/

# ============================================
# 常见临时文件和备份
# ============================================

# 编辑器备份
*~
*.bak
*.swp
*.tmp
*.temp

# 压缩包（根据需要调整）
*.zip
*.rar
*.7z

# 日志文件
*.log

# ============================================
# 其他工具生成文件
# ============================================

# pack包缓存
.pack/
.web/

# Python编译文件（如果使用Python脚本）
__pycache__/
*.py[cod]
*.pyo

# ============================================
# 项目特定（根据实际需求调整）
# ============================================

# 如果有自动生成的文档
# docs/html/
# docs/latex/
